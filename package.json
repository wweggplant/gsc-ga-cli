{
  "name": "gsc-ga-cli",
  "version": "0.1.0",
  "description": "Generate deterministic Markdown SEO reports from Google Search Console, GA4, and optional Microsoft Clarity data.",
  "type": "module",
  "bin": {
    "gsc-ga": "dist/cli.js"
  },
  "files": [
    "dist/",
    "config/sites.example.json",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm build && pnpm check:package"
  },
  "keywords": [
    "google-search-console",
    "google-analytics",
    "ga4",
    "seo",
    "cli",
    "markdown",
    "clarity"
  ],
  "author": "wweggplant",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wweggplant/gsc-ga-cli.git"
  },
  "bugs": {
    "url": "https://github.com/wweggplant/gsc-ga-cli/issues"
  },
  "homepage": "https://github.com/wweggplant/gsc-ga-cli#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "google-auth-library": "^9.15.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.23.0"
}
