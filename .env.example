# Optional: standard Google Application Default Credentials path.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional config fallback; --config takes precedence.
GSC_GA_CONFIG=./gsc-ga.config.json

# Optional default output directory; --output takes precedence.
GSC_GA_OUTPUT_DIR=./reports

# Optional tokens referenced by clarity.tokenEnv in site configuration.
CLARITY_TOKEN_EXAMPLE=replace-with-your-token
